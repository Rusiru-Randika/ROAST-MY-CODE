# =========================================================
# Roast My Code - Environment Variables Template
# Copy this file to .env and insert your real values.
# DO NOT commit your .env file with real secrets to GitHub!
# =========================================================

# Option 1: Direct Google Gemini API (Recommended & Fast)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: AWS Lambda Backend Function URL (Optional)
# Example: https://xxxxxx.lambda-url.us-east-1.on.aws/
VITE_API_URL=https://your-lambda-url.on.aws/
